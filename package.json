{
  "name": "erp-web",
  "version": "0.1.0",
  "private": true,
  "description": "ERP SaaS multi-tenant para pequenos comercios do varejo alimentar",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "ts-standard 'src/**/*.{ts,tsx}' && eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio --host 0.0.0.0 --port 4983",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:fix": "ts-standard --fix 'src/**/*.{ts,tsx}'",
    "lint:dead": "knip",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006 -h 0.0.0.0",
    "build-storybook": "storybook build",
    "perf": "node scripts/orcamento.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.1.0",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.5",
    "jose": "^6.2.9",
    "next": "15.5.4",
    "postgres": "^3.4.7",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^9.1.10",
    "@storybook/addon-docs": "^9.1.10",
    "@storybook/nextjs-vite": "^9.1.10",
    "@tailwindcss/postcss": "^4.1.13",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9.36.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^27.0.0",
    "knip": "^5.64.1",
    "postcss": "^8.5.26",
    "storybook": "^9.1.10",
    "tailwindcss": "^4.1.13",
    "ts-standard": "^12.0.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.2.4"
  },
  "ts-standard": {
    "ignore": [
      "legacy",
      ".next",
      "drizzle",
      "**/*.stories.tsx"
    ],
    "project": "./tsconfig.json"
  }
}