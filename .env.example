# Copie para .env  ->  cp .env.example .env
# Todos os valores tem padrao no docker-compose.yml; este arquivo so
# e necessario se voce quiser mudar portas, usuario ou senha.

# --- Banco de dados -------------------------------------------------------
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp
POSTGRES_DB=erp

# Porta em que o Postgres fica exposto NO SEU HOST (para DBeaver/psql).
# 5433 evita conflito com um Postgres ja instalado na maquina.
DB_PORT=5433

# --- Aplicacao ------------------------------------------------------------
APP_PORT=3000

# Segredo de assinatura das sessoes. Em producao, gere com:
#   docker compose run --rm app node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=dev-secret-nao-usar-em-producao

# --- Ferramentas opcionais (profile "tools") ------------------------------
STUDIO_PORT=4983
PGWEB_PORT=8081

# Senha do papel de aplicacao (erp_app), criado pela migration 0000.
# Este papel roda com NOBYPASSRLS - e o que garante o isolamento entre tenants.
APP_DB_PASSWORD=erp_app
