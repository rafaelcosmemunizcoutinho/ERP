{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [".claude/hooks/sessao.mjs"],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [".claude/hooks/guarda-bash.mjs"],
            "timeout": 10,
            "statusMessage": "Conferindo container, ramo e heredoc"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [".claude/hooks/guarda-migration.mjs"],
            "timeout": 10,
            "statusMessage": "Conferindo se a migration já existe"
          }
        ]
      }
    ]
  }
}
